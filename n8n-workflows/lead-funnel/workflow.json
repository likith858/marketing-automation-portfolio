        "jsCode": "const d = $input.item.json;\n\n// keep only digits: \"+91 98765-43210\" -> \"919876543210\"\nlet phone = String(d.Phone || '').replace(/\\D/g, '');\n\n// remove India code 91 if they added it\nif (phone.length === 12 && phone.startsWith('91')) {\n  phone = phone.slice(2);\n}\n\nreturn {\n  json: {\n    Name: String(d.Name || '').trim(),\n    Phone: phone,\n    Email: String(d.Email || '').trim().toLowerCase(),\n    Course: d.Course\n  }\n};"
