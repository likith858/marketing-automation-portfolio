    {
      "parameters": {
        "jsCode": "const today = $now.setZone('Asia/Kolkata').toFormat('dd LLL yyyy');\nconst rows = $input.all().map(item => item.json);\nconst todaysAll = rows.filter(r => String(r.created_at).startsWith(today));\n// keep one row per phone number (removes duplicate form submissions)\nconst todays = [...new Map(todaysAll.map(r => [String(r.phone), r])).values()];\nconst hot = todays.filter(r => String(r.status).startsWith('Hot'));\nconst cold = todays.filter(r => String(r.status).startsWith('Cold'));\nreturn [{ json: {\n  date: today,\n  total: todays.length,\n  hot: hot.length,\n  cold: cold.length,\n  call_first: hot.map(r => r.name + ' (' + r.phone + ')').join(', ') || 'None'\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
